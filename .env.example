# ==============================================================================
# CONNECTX - Global Skill-to-Employment Intelligence Platform
# "Your Skills. Their Opportunities. A Better Future."
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
PROJECT_NAME="CONNECTX"
API_V1_STR=/api/v1

# PostgreSQL Database Configuration
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=connectx_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
DATABASE_URL=postgresql://postgres:postgres_dev_password@db:5432/connectx_db

# Security & JWT Authentication
# In production, generate a secure 256-bit random key via: openssl rand -hex 32
SECRET_KEY=dev_jwt_secret_placeholder_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google Gemini AI Configuration (Backend Only - NEVER expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# CORS Configuration (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
